  <Import Project="Version.targets" />

  <!-- Auto-deploy the built mod into the game so a rebuild is picked up on the next launch.
       Universal deploys to both loader folders; a single-loader build deploys only to its folder.
       A running game locks the DLL; the copy then fails with a clear warning (ContinueOnError). -->
  <Target Name="DeployModToGame" AfterTargets="Build" Condition="'$(ContinuousIntegrationBuild)' != 'true'">
    <ItemGroup>
      <UnifiedDeployDir Include="$(HeartopiaDir)\Mods"
        Condition="Exists('$(HeartopiaDir)\Mods') And ('$(Loader)' == 'Universal' Or '$(Loader)' == 'MelonLoader')" />
      <UnifiedDeployDir Include="$(BepInExDir)\plugins"
        Condition="Exists('$(BepInExDir)\plugins') And ('$(Loader)' == 'Universal' Or '$(Loader)' == 'BepInEx')" />
    </ItemGroup>
    <Copy SourceFiles="$(OutputPath)bugtopia.dll"
          DestinationFolder="%(UnifiedDeployDir.Identity)"
          ContinueOnError="true"
          Condition="'@(UnifiedDeployDir)' != ''">
      <Output TaskParameter="CopiedFiles" ItemName="DeployedDll" />
    </Copy>
    <Copy SourceFiles="$(OutputPath)bugtopia.pdb"
          DestinationFolder="%(UnifiedDeployDir.Identity)"
          ContinueOnError="true"
          Condition="'@(UnifiedDeployDir)' != '' and Exists('$(OutputPath)bugtopia.pdb')" />
    <!-- Gate the success line on the copy ACTUALLY having happened. It used to be conditioned on
         the destination folder merely existing, so a locked DLL (game running) still printed
         "Deployed" while the file on disk stayed at the previous build — the MSB3021 warning that
         did fire is easy to miss in a filtered build log. Trusting that line cost a debugging
         round; now silence means nothing was copied. -->
    <Message Importance="high"
             Text="Deployed bugtopia.dll -> %(UnifiedDeployDir.Identity)"
             Condition="'@(DeployedDll)' != ''" />
    <Warning Text="bugtopia.dll was NOT deployed (destination locked — is the game running?). The game folder still has the PREVIOUS build."
             Condition="'@(UnifiedDeployDir)' != '' and '@(DeployedDll)' == ''" />
    <Warning Text="No loader folder found to deploy bugtopia.dll into (Loader=$(Loader)). Looked for $(HeartopiaDir)\Mods and $(BepInExDir)\plugins."
             Condition="'@(UnifiedDeployDir)' == ''" />
  </Target>
</Project>
