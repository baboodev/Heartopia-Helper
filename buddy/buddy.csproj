<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <!-- Loader: Universal (default) = one DLL for both loaders (CI/release). BepInEx / MelonLoader =
         single-loader DLL that only needs that loader installed to build. -->
    <Loader Condition="'$(Loader)' == ''">Universal</Loader>
    <!-- Telegram: true (default) = the Bugtopia News link ships (sidebar footer + About button).
         false = a build with NO trace of it. This MUST stay a compile-time switch, not a runtime
         flag: #if strips the code AND its string literals from the assembly, whereas a bool would
         leave "https://t.me/..." sitting in the DLL's string heap for anyone to grep. -->
    <Telegram Condition="'$(Telegram)' == ''">true</Telegram>
    <!-- Mcp: false (default) = the agent bridge is not in the binary at all. true = compile it
         (McpJson / McpOps / McpBridgeFeature / HeartopiaComplete.Mcp). Like Telegram this MUST stay
         a compile-time switch: #if strips the code AND the listener's string literals, so a build
         without it cannot be switched on by dropping the marker file — there is nothing to switch.
         BEPINEX ONLY, by decision: the bridge is a development surface and there is no reason to
         carry a second loader's code paths through it. ValidateMcpLoader below enforces that. -->
    <Mcp Condition="'$(Mcp)' == ''">false</Mcp>
    <HeartopiaDir Condition="'$(HeartopiaDir)' == ''">D:\SteamLibrary\steamapps\common\Heartopia</HeartopiaDir>
    <!-- BepInEx root. Defaults to the install-next-to-the-game layout (and CI, where the deps zip
         extracts to BepInEx\core + MelonLoader\net6 side by side under HeartopiaDir), but Doorstop's
         target_assembly can point anywhere, so this is a separate knob: reference assemblies AND the
         plugins deploy folder both hang off it, not off the game dir. -->
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(HeartopiaDir)\BepInEx</BepInExDir>
    <!-- Same for MelonLoader. CI keeps the default: the workflow extracts unified-ci-deps.zip to
         ci\heartopia and passes that as HeartopiaDir, so both loaders sit under it side by side. -->
    <MelonLoaderDir Condition="'$(MelonLoaderDir)' == ''">$(HeartopiaDir)\MelonLoader</MelonLoaderDir>
    <OutputType>Library</OutputType>
    <AssemblyName>bugtopia</AssemblyName>
    <RootNamespace>buddy</RootNamespace>
    <TargetFramework>net6.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 10.0 for the global using in GlobalUsings.cs (per-loader TMPro namespace) -->
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Loader)\$(Configuration)\</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- CS0162 (unreachable code) is by-design: the Master*/debugLoggingEnabled const-false switches
         compile debug-log bodies out, which the compiler flags en masse. Nothing to fix. -->
    <NoWarn>$(NoWarn);CS0162</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Shipping build: hide loader console after startup, no verbose mod logs -->
  <PropertyGroup Condition="'$(Configuration)' == 'ReleaseShip'">
    <DefineConstants>TRACE;HIDE_LOADER_CONSOLE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Loader selection. LOADER_MELON / LOADER_BEPINEX gate the loader-specific glue (entry points +
       log/coroutine adapters). Universal defines BOTH → one DLL with runtime dispatch on
       ModLoaderInfo.IsMelonLoader; a single-loader build defines only its own and never references
       the other loader's assembly. -->
  <PropertyGroup Condition="'$(Loader)' == 'Universal'">
    <DefineConstants>$(DefineConstants);LOADER_MELON;LOADER_BEPINEX</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Loader)' == 'MelonLoader'">
    <DefineConstants>$(DefineConstants);LOADER_MELON</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Loader)' == 'BepInEx'">
    <DefineConstants>$(DefineConstants);LOADER_BEPINEX</DefineConstants>
  </PropertyGroup>

  <!-- FEATURE_TELEGRAM gates the Bugtopia News link: the URL constant, the OpenURL helper, the
       sidebar-footer link, the About button, the paper-plane icon and the one localized error
       string. Build without it: -p:Telegram=false -->
  <PropertyGroup Condition="'$(Telegram)' == 'true'">
    <DefineConstants>$(DefineConstants);FEATURE_TELEGRAM</DefineConstants>
  </PropertyGroup>

  <!-- FEATURE_MCP gates the whole agent bridge. Build it with:
         dotnet build buddy.csproj -c Release -p:Loader=BepInEx -p:Mcp=true -->
  <PropertyGroup Condition="'$(Mcp)' == 'true'">
    <DefineConstants>$(DefineConstants);FEATURE_MCP</DefineConstants>
  </PropertyGroup>

  <!-- Fail loudly instead of quietly producing a Universal/MelonLoader DLL with a listening socket
       in it. The bridge is BepInEx-only on purpose (see the Mcp property above). -->
  <Target Name="ValidateMcpLoader" BeforeTargets="BeforeBuild"
          Condition="'$(Mcp)' == 'true' And '$(Loader)' != 'BepInEx'">
    <Error Text="Mcp=true is supported only with Loader=BepInEx (got Loader=$(Loader)). Build with: dotnet build buddy.csproj -c Release -p:Loader=BepInEx -p:Mcp=true" />
  </Target>

  <!-- BepInEx + shared deps + IL2CPP interop, from the BepInEx install. Used by the BepInEx build
       AND the Universal build (Universal adds only MelonLoader.dll below). No game assemblies:
       all game access is string-based via AuraMono / il2cpp_* by name. -->
  <ItemGroup Condition="'$(Loader)' == 'BepInEx' Or '$(Loader)' == 'Universal'">
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>$(BepInExDir)\core\MonoMod.RuntimeDetour.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>$(BepInExDir)\core\MonoMod.Utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(BepInExDir)\core\Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExDir)\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExDir)\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(BepInExDir)\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(BepInExDir)\interop\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityEngine.AI (NavMesh.CalculatePath / SamplePosition). The game registers its baked mesh
         with the stock AI system (XDNavigation.XDNavigationMgr holds a NavMeshData +
         NavMeshDataInstance), which is what the Aura Farm's walk-to-node mode paths along. -->
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(BepInExDir)\interop\UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(BepInExDir)\interop\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(BepInExDir)\interop\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BepInExDir)\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(BepInExDir)\interop\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(BepInExDir)\interop\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(BepInExDir)\interop\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(BepInExDir)\interop\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.SharedInternalsModule">
      <HintPath>$(BepInExDir)\interop\UnityEngine.SharedInternalsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(BepInExDir)\interop\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(BepInExDir)\interop\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(BepInExDir)\interop\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(BepInExDir)\interop\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(BepInExDir)\interop\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Universal only: add MelonLoader.dll (shared deps + interop come from the BepInEx group above). -->
