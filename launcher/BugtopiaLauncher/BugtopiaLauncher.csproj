<Project Sdk="Microsoft.NET.Sdk">

  <!-- The launcher: Photino's native webview shell, published with NativeAOT, one file.

       Photino rather than the WebView2 .NET SDK, for a measured reason. The SDK marshals its
       completion handler through COM from managed code, which NativeAOT cannot do at all, so it is
       stuck on a JIT build at ~12 MB. Photino does the webview work in C++ behind plain P/Invoke,
       compiles AOT cleanly, and lands at about 6 MB with the payload — see
       docs/plans/2026-08-28-launcher-consolidation.md.

       Two builds ship from here:
         offline (default)  - contains no network code at all, and carries the mod inside it
         online             - dotnet publish ... -p:BugtopiaOnline=true

       A compile-time switch rather than a setting, so the offline build cannot reach the network
       even by accident and does not link the stack it would need to.

       The two differ in what they carry, not just in what they can do. The offline build embeds
       bugtopia.dll and installs that exact copy; the online build embeds no plugin at all and
       fetches the newest release from github.com/baboodev/Bugtopia instead, so it never ships a
       mod that is already out of date.

       Each flavour builds into bin\<flavour>\ and obj\<flavour>\, so the two can sit side by side
       instead of overwriting each other. See launcher/Directory.Build.props.

       NativeAOT needs the MSVC linker. In a shell where the toolchain probe cannot run vswhere,
       initialise vcvars64.bat first and add -p:IlcUseEnvironmentalTools=true; note vcvars sets
       Platform=x64, which moves the output under bin\<flavour>\x64\. ALWAYS run the exe from publish\ —
       bin\...\native\ holds the binary without its native shell, and a missing P/Invoke target under
       AOT fail-fasts with 0xC0000409 instead of saying what is missing.

       Publish: dotnet publish launcher/BugtopiaLauncher/BugtopiaLauncher.csproj -c Release
       Build the payload first: launcher/BugtopiaInject/build.bat, launcher/BugtopiaInterop, and the
       mod's BepInEx flavour. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Bugtopia</AssemblyName>
    <RootNamespace>Bugtopia.Launcher</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>assets\bugtopia.ico</ApplicationIcon>
    <!-- The three version attributes come from the generated file below instead of the SDK.
         Only those three: turning the whole of GenerateAssemblyInfo off would also drop the
         SupportedOSPlatform attribute that net8.0-windows implies, and 154 CA1416 warnings would
         appear in its place. -->
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
  </PropertyGroup>

  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <TrimMode>full</TrimMode>
    <!-- Nothing here consumes DiagnosticSource, so HTTP requests need not carry Activity
         propagation with them. Worth 84 KB in the online build, measured. Two neighbouring ideas
         were measured and are NOT here: UseNativeHttpHandler made the binary 512 bytes larger, and
         turning Http3Support off changed nothing at all. -->
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Payload sources: build outputs of sibling projects rather than files in the tree. -->
    <PhotinoNativePath>$(NuGetPackageRoot)photino.native\4.0.22\runtimes\win-x64\native\Photino.Native.dll</PhotinoNativePath>
    <WebView2LoaderPath>$(NuGetPackageRoot)photino.native\4.0.22\runtimes\win-x64\native\WebView2Loader.dll</WebView2LoaderPath>
    <InjectDllPath>$(MSBuildThisFileDirectory)..\BugtopiaInject\bin\bugtopia_inject.dll</InjectDllPath>
    <InteropShimPath>$(MSBuildThisFileDirectory)..\BugtopiaInterop\bin\Release\net6.0\BugtopiaInterop.dll</InteropShimPath>
    <PluginDllPath Condition="'$(PluginDllPath)' == ''">$(MSBuildThisFileDirectory)..\..\buddy\bin\BepInEx\ReleaseShip\bugtopia.dll</PluginDllPath>
  </PropertyGroup>

  <!-- The launcher takes its version from the same script the mod does, so it can never claim a
       different build from the plugin it carries. Both read the tag and the short SHA out of
       this working tree, and both render them as "2.8.2 (46f9cfb)". -->
  <PropertyGroup>
    <LauncherVersionFile>$(BaseIntermediateOutputPath)LauncherVersion.g.cs</LauncherVersionFile>
    <ResolveBuildVersionScript>$(MSBuildThisFileDirectory)..\..\ci\resolve-build-version.ps1</ResolveBuildVersionScript>
  </PropertyGroup>

  <Target Name="GenerateLauncherVersion" BeforeTargets="BeforeCompile">
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ResolveBuildVersionScript)&quot; -OutputPath &quot;$(LauncherVersionFile)&quot;" />
    <ItemGroup>
      <Compile Include="$(LauncherVersionFile)" />
      <FileWrites Include="$(LauncherVersionFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\BugtopiaLaunch\BugtopiaLaunch.csproj" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ui.html" LogicalName="ui.html" />
    <!-- The header graphic, folded into the page as a data URI when it is loaded. -->
    <EmbeddedResource Include="assets\logo.png" LogicalName="logo.png" />
    <!-- ApplicationIcon above puts this in the exe's Win32 resources, which is what Explorer
         reads; the window itself needs a file on disk, so it rides as a resource too. -->
    <EmbeddedResource Include="assets\bugtopia.ico" LogicalName="bugtopia.ico" />
    <!-- The webview shell itself. AOT cannot bundle a native dependency and the package ships no
         static library, so it rides as a resource and NativeShell unpacks it on first run. -->
    <EmbeddedResource Include="$(PhotinoNativePath)" LogicalName="Photino.Native.dll"
                      Condition="Exists('$(PhotinoNativePath)')" />
    <!-- Photino.Native imports this one. Leaving it out is not a smaller build, it is a build that
         only starts on a machine that happens to have a copy on PATH. -->
    <EmbeddedResource Include="$(WebView2LoaderPath)" LogicalName="WebView2Loader.dll"
                      Condition="Exists('$(WebView2LoaderPath)')" />
    <EmbeddedResource Include="$(InjectDllPath)" LogicalName="payload.bugtopia_inject.dll"
                      Condition="Exists('$(InjectDllPath)')" />
    <EmbeddedResource Include="$(InteropShimPath)" LogicalName="payload.BugtopiaInterop.dll"
                      Condition="Exists('$(InteropShimPath)')" />
    <!-- Only the offline build carries the mod. See the header. -->
    <EmbeddedResource Include="$(PluginDllPath)" LogicalName="payload.bugtopia.dll"
                      Condition="'$(BugtopiaOnline)' != 'true' and Exists('$(PluginDllPath)')" />
  </ItemGroup>

  <!-- A launcher without its payload builds and runs, and says which piece is missing when Prepare
       needs it. Failing the build would make the projects impossible to work on separately. The
       webview shell is different: without it there is no window at all, so that one is an error. -->
  <Target Name="CheckPayload" BeforeTargets="Build">
    <Error Text="Photino.Native.dll not found at $(PhotinoNativePath) - restore the Photino.NET package first."
           Condition="!Exists('$(PhotinoNativePath)')" />
    <Error Text="WebView2Loader.dll not found at $(WebView2LoaderPath) - restore the Photino.NET package first."
           Condition="!Exists('$(WebView2LoaderPath)')" />
    <Warning Text="Payload missing: $(InjectDllPath) - run launcher/BugtopiaInject/build.bat"
             Condition="!Exists('$(InjectDllPath)')" />
    <Warning Text="Payload missing: $(InteropShimPath) - build launcher/BugtopiaInterop -c Release"
             Condition="!Exists('$(InteropShimPath)')" />
    <Warning Text="Payload missing: $(PluginDllPath) - build the mod with -c ReleaseShip -p:Loader=BepInEx, or set PluginDllPath"
             Condition="'$(BugtopiaOnline)' != 'true' and !Exists('$(PluginDllPath)')" />
  </Target>

  <!-- One file means one file: the native shell is inside the binary, not beside it. -->
  <Target Name="TrimPublishOutput" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.dll' or '%(Extension)' == '.xml' or '%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
